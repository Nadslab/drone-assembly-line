<?xml version="1.0"?>
<!--
  One gantry: X, Y, Z (and C when the spec keeps a yaw axis), from line_spec.yaml (plan P5.3).
  Macro library: no <robot name>, so this file is never expanded on its own — urdf/line.urdf.xacro
  instantiates the macro once per `gantries` entry (D-008), as `Gantry_<n>` with joints
  `gantry_<n>_<axis>`. Follows the P1 spike (urdf/spike_axis.urdf.xacro), which is the one axis in
  this repo known to move under gz_ros2_control.

  **Every joint limit comes from the spec** — `gantries.<id>.axes.<axis>.{min,max,v_max,a_max}` —
  and the axis frames are the kinematic truth: a joint's value *is* the TCP coordinate in that
  gantry's frame, so `Gantry_<n>_Tcp` sits at `gantries.<id>.mount + (x, y, z)` with no offset of
  its own. check_line.py's reach check compares a pose against the same limits the same way
  (pose - mount), so the description and the check cannot disagree.

  `damping`/`friction` are the P1 values (docs/decisions.md D-002): an axis's own, else
  `gantry_defaults` for x/y/z (the rotary C axis only ever takes its own — other units). A
  `<dynamics>` tag is written only for an axis that ends up with a damping. `position_gain` is
  per axis and goes to the ros2_control block in line.urdf.xacro.

  Numbers typed in this file are **envelopes**: the structure's masses and the boxes it is drawn
  as. They say how heavy the moving structure is and roughly where it is, which is what an inertia
  and a picture need; no deliverable number comes from here. Travel, limits and mount all come from
  the spec. Two consequences worth naming:

  * **effort is derived, not typed.** A URDF joint needs one, and the spec has no force field, so
    each axis gets the force to accelerate what it actually carries: moved mass x `a_max`, plus
    the axis's own friction, plus gravity on the vertical axis.
  * **no collision geometry.** The gantry is position-commanded (D-002: `GazeboSimSystem` drives
    the joint from position error), so a colliding structure fights the drive instead of stopping
    it. Picking is a `DetachableJoint` at the TCP (P7), not a contact.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- envelopes, metres and kilograms: the moving structure, not the spec -->
  <xacro:property name="g_accel" value="9.81"/>
  <xacro:property name="m_bridge" value="30.0"/>     <!-- X: the bridge across the line -->
  <xacro:property name="m_carriage" value="12.0"/>   <!-- Y: the carriage on the bridge -->
  <xacro:property name="m_column" value="6.0"/>      <!-- Z: the column, tool included -->
  <xacro:property name="m_rotor" value="1.5"/>       <!-- C: the yaw rotor -->
  <xacro:property name="m_payload" value="1.0"/>     <!-- heaviest thing it carries, allowance -->
  <xacro:property name="bridge_x" value="0.30"/>
  <xacro:property name="bridge_z" value="0.15"/>
  <xacro:property name="bridge_over" value="0.30"/>  <!-- bridge beyond the y travel, both ends -->
  <xacro:property name="carriage_xy" value="0.25"/>
  <xacro:property name="carriage_z" value="0.12"/>
  <xacro:property name="column_xy" value="0.12"/>
  <xacro:property name="column_over" value="0.20"/>  <!-- column above the top of the z travel -->
  <xacro:property name="rotor_xy" value="0.10"/>
  <xacro:property name="rotor_z" value="0.06"/>
  <xacro:property name="rail_clear" value="0.15"/>   <!-- bridge underside above the z travel -->
  <xacro:property name="base_xyz" value="0.20"/>
  <xacro:property name="m_base" value="40.0"/>

  <xacro:property name="colour_struct" value="0.25 0.45 0.65 1"/>
  <xacro:property name="colour_moving" value="0.75 0.60 0.20 1"/>

  <xacro:macro name="gantry" params="parent name prefix axes dyn *origin">
    <xacro:property name="ax" value="${axes}"/>
    <xacro:property name="has_c" value="${'c' in ax and ax['c'] is not None}"/>

    <!-- Linear-axis dynamics: the axis's own value, else gantry_defaults (D-002). -->
    <xacro:property name="d_x" value="${ax['x']['damping'] if ax['x'].get('damping') is not None
                                        else dyn.get('damping')}"/>
    <xacro:property name="f_x" value="${ax['x']['friction'] if ax['x'].get('friction') is not None
                                        else (dyn.get('friction') or 0.0)}"/>
    <xacro:property name="d_y" value="${ax['y']['damping'] if ax['y'].get('damping') is not None
                                        else dyn.get('damping')}"/>
    <xacro:property name="f_y" value="${ax['y']['friction'] if ax['y'].get('friction') is not None
                                        else (dyn.get('friction') or 0.0)}"/>
    <xacro:property name="d_z" value="${ax['z']['damping'] if ax['z'].get('damping') is not None
                                        else dyn.get('damping')}"/>
    <xacro:property name="f_z" value="${ax['z']['friction'] if ax['z'].get('friction') is not None
                                        else (dyn.get('friction') or 0.0)}"/>

    <!-- Travel, from the spec. Everything below is placed relative to it. -->
    <xacro:property name="y_lo" value="${ax['y']['min']}"/>
    <xacro:property name="y_hi" value="${ax['y']['max']}"/>
    <xacro:property name="z_hi" value="${ax['z']['max']}"/>
    <xacro:property name="z_lo" value="${ax['z']['min']}"/>
    <xacro:property name="rail_z" value="${z_hi + rail_clear}"/>

    <!-- Moved mass per axis: what that axis has to accelerate (see the header). -->
    <xacro:property name="m_tool" value="${m_column + (m_rotor if has_c else 0.0) + m_payload}"/>
    <xacro:property name="m_moved_y" value="${m_carriage + m_tool}"/>
    <xacro:property name="m_moved_x" value="${m_bridge + m_moved_y}"/>

    <!-- base: welded to the parent at gantries.<id>.mount -->
    <xacro:box_link name="${name}_base" m="${m_base}" x="${base_xyz}" y="${base_xyz}"
                    z="${base_xyz}" colour="${colour_struct}" cz="${rail_z}"/>
    <joint name="${prefix}mount" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_base"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- X: the bridge, spanning the y travel -->
    <xacro:box_link name="${name}_x" m="${m_bridge}" x="${bridge_x}"
                    y="${y_hi - y_lo + 2 * bridge_over}" z="${bridge_z}"
                    colour="${colour_struct}" cy="${(y_lo + y_hi) / 2.0}"
                    cz="${rail_z + bridge_z / 2.0}"/>
    <joint name="${prefix}x" type="prismatic">
      <parent link="${name}_base"/>
      <child link="${name}_x"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${ax['x']['min']}" upper="${ax['x']['max']}"
             velocity="${ax['x']['v_max']}"
             effort="${m_moved_x * ax['x']['a_max'] + f_x}"/>
      <xacro:if value="${d_x is not None}">
        <dynamics damping="${d_x}" friction="${f_x}"/>
      </xacro:if>
    </joint>

    <!-- Y: the carriage on the bridge -->
    <xacro:box_link name="${name}_y" m="${m_carriage}" x="${carriage_xy}" y="${carriage_xy}"
                    z="${carriage_z}" colour="${colour_moving}"
                    cz="${rail_z + bridge_z + carriage_z / 2.0}"/>
    <joint name="${prefix}y" type="prismatic">
      <parent link="${name}_x"/>
      <child link="${name}_y"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${ax['y']['min']}" upper="${ax['y']['max']}"
             velocity="${ax['y']['v_max']}"
             effort="${m_moved_y * ax['y']['a_max'] + f_y}"/>
      <xacro:if value="${d_y is not None}">
        <dynamics damping="${d_y}" friction="${f_y}"/>
      </xacro:if>
    </joint>

    <!-- Z: the column. Its frame is the tool point, so the column is drawn above it. -->
    <xacro:box_link name="${name}_z" m="${m_column}" x="${column_xy}" y="${column_xy}"
                    z="${z_hi - z_lo + column_over}" colour="${colour_moving}"
                    cz="${(z_hi - z_lo + column_over) / 2.0}"/>
    <xacro:no_gravity link="${name}_z"/>
    <joint name="${prefix}z" type="prismatic">
      <parent link="${name}_y"/>
      <child link="${name}_z"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${ax['z']['min']}" upper="${ax['z']['max']}"
             velocity="${ax['z']['v_max']}"
             effort="${m_tool * (ax['z']['a_max'] + g_accel) + f_z}"/>
      <xacro:if value="${d_z is not None}">
        <dynamics damping="${d_z}" friction="${f_z}"/>
      </xacro:if>
    </joint>

    <!-- C: yaw, only when the spec keeps the axis -->
    <xacro:if value="${has_c}">
      <xacro:box_link name="${name}_c" m="${m_rotor}" x="${rotor_xy}" y="${rotor_xy}"
                      z="${rotor_z}" colour="${colour_moving}" cz="${rotor_z / 2.0}"/>
      <xacro:no_gravity link="${name}_c"/>
      <joint name="${prefix}c" type="revolute">
        <parent link="${name}_z"/>
        <child link="${name}_c"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <!-- Rotary: inertia x a_max, the rotor plus what it carries as one box. -->
        <limit lower="${ax['c']['min']}" upper="${ax['c']['max']}"
               velocity="${ax['c']['v_max']}"
               effort="${(m_rotor + m_payload) / 12.0 * 2 * rotor_xy * rotor_xy
                         * ax['c']['a_max'] + (ax['c'].get('friction') or 0.0)}"/>
        <xacro:if value="${ax['c'].get('damping') is not None}">
          <dynamics damping="${ax['c']['damping']}" friction="${ax['c'].get('friction') or 0.0}"/>
        </xacro:if>
      </joint>
      <xacro:property name="tcp_parent" value="${name}_c"/>
    </xacro:if>
    <xacro:unless value="${has_c}">
      <xacro:property name="tcp_parent" value="${name}_z"/>
    </xacro:unless>

    <!-- TCP: where a tool's pick frame meets the gantry. No offset: the joint values are
              the TCP coordinates in the gantry frame (see the header). -->
    <link name="${name}_Tcp"/>
    <joint name="${prefix}tcp" type="fixed">
      <parent link="${tcp_parent}"/>
      <child link="${name}_Tcp"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
