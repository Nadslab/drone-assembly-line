<?xml version="1.0"?>
<!--
  The line's machines as one description, from line_spec.yaml (plan P5.3):
  one gantry per `gantries` entry at its `mount` (D-008), and one gang head per `gang_heads` entry
  at the station the sequence gives it. Expand it with

      xacro drone_line_sim/urdf/line.urdf.xacro \
            spec_file:=<merged spec> controllers_file:=<controllers.yaml>

  and `tools/checks/descriptions.sh` does exactly that, then runs check_urdf and compares every
  joint limit with the spec.

  **Why one robot and not three.** `gz_ros2_control` starts a controller manager per model, and
  one controller manager reads one parameter file. `config/controllers.yaml` holds one controller
  per gantry *and* one per head (plan P5.3), so they have to share a manager — which means one
  model, one `<ros2_control>` component, one `robot_description`. The machines are welded to the
  world and never touch each other, so nothing is lost by describing them together.

  The `world` root link is the P1 spike's pattern (urdf/spike_axis.urdf.xacro): sdformat turns a
  fixed joint from a link named `world` into an attachment to the world, which is what a machine
  frame bolted to the floor is.

  Joint names are the spec's ids: `gantry_<n>_<axis>` and `<head_id>_stroke` (`_1`/`_2` for the
  two banks of an opposed head); gantry links are `Gantry_<n>_<axis>` and `Gantry_<n>_Tcp`. tools/gen_controllers.py builds the same names from the same spec, and
  descriptions.sh fails if the two ever disagree.
-->
<robot name="line" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="spec_file" default="$(find drone_line_sim)/config/line_spec.yaml"/>
  <xacro:arg name="controllers_file" default="$(find drone_line_sim)/config/controllers.yaml"/>

  <xacro:include filename="inertia.urdf.xacro"/>
  <xacro:include filename="gantry.urdf.xacro"/>
  <xacro:include filename="gang_head.urdf.xacro"/>

  <xacro:property name="spec" value="${xacro.load_yaml('$(arg spec_file)')}"/>
  <xacro:property name="dyn" value="${spec['gantry_defaults']}"/>
  <xacro:property name="head_gap" value="0.01"/>   <!-- envelope: gap left when a ram is out -->

  <!-- the line frame: welded to the world at the spec's origin -->
  <link name="world"/>
  <link name="Line_base"/>
  <joint name="line_base" type="fixed">
    <parent link="world"/>
    <child link="Line_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- a gantry per spec entry: gantry_<n> -> Gantry_<n>, joints gantry_<n>_* -->
  <xacro:macro name="gantries_from_spec" params="parent ids">
    <xacro:if value="${len(ids) > 0}">
      <xacro:property name="gid" value="${ids[0]}"/>
      <xacro:property name="g" value="${spec['gantries'][gid]}"/>
      <xacro:gantry parent="${parent}" name="${'Gantry_' + gid.removeprefix('gantry_')}"
                    prefix="${gid}_" axes="${g['axes']}" dyn="${dyn}">
        <origin xyz="${g['mount'][0]} ${g['mount'][1]} ${g['mount'][2]}" rpy="0 0 0"/>
      </xacro:gantry>
      <xacro:gantries_from_spec parent="${parent}" ids="${ids[1:]}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:gantries_from_spec parent="Line_base" ids="${python.sorted(spec['gantries'])}"/>

  <!-- a gang head per spec entry, at the station its sequence step names -->
  <xacro:macro name="heads_from_spec" params="parent ids">
    <xacro:if value="${len(ids) > 0}">
      <xacro:property name="hid" value="${ids[0]}"/>
      <xacro:property name="h" value="${spec['gang_heads'][hid]}"/>
      <xacro:property name="pose"
                      value="${spec['stations'][[s['station'] for s in spec['sequence']
                                                 if s.get('head') == hid][0]]['pose']}"/>
      <xacro:property name="pat"
                      value="${spec['parts'][h['pattern_from'].split('.')[0]]
                                            [h['pattern_from'].split('.')[1]]['positions']
                               if h.get('pattern_from') else []}"/>
      <!-- A vertical head stands off by its own stroke, so the advanced ram reaches the work. -->
      <xacro:property name="dz"
                      value="${0.0 if h['direction'] == 'horizontal'
                               else (h['stroke'] + head_gap)
                                    * (1 if h['direction'] == 'down' else -1)}"/>
      <xacro:gang_head parent="${parent}"
                       name="${'GangHead_' + ''.join(w.capitalize()
                                for w in hid.removeprefix('gh_').split('_'))}"
                       prefix="${hid}_" direction="${h['direction']}" spindles="${h['spindles']}"
                       stroke="${h['stroke']}" v_max="${h['v_max']}" a_max="${h['a_max']}"
                       opposed="${bool(h.get('opposed')) and h['direction'] == 'horizontal'}"
                       positions="${pat}">
        <origin xyz="${pose[0]} ${pose[1]} ${pose[2] + dz}" rpy="0 0 ${pose[3] or 0.0}"/>
      </xacro:gang_head>
      <xacro:heads_from_spec parent="${parent}" ids="${ids[1:]}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:heads_from_spec parent="Line_base" ids="${python.sorted(spec['gang_heads'])}"/>

  <!-- ros2_control: one system, every joint on a position interface
       `position_proportional_gain` is the gz_ros2_control gain from D-002, a spec field
       (`gantries.<id>.axes.<axis>.position_gain`); an axis without one keeps the plugin's default.
       `initial_value` is 0 where 0 is inside the travel, the nearest limit otherwise. -->
  <xacro:macro name="control_joint" params="name initial gain:=''">
    <joint name="${name}">
      <command_interface name="position">
        <xacro:if value="${gain != ''}">
          <param name="position_proportional_gain">${gain}</param>
        </xacro:if>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="control_joints" params="items">
    <xacro:if value="${len(items) > 0}">
      <xacro:property name="it" value="${items[0]}"/>
      <xacro:control_joint name="${it[0]}" initial="${it[1]}" gain="${it[2]}"/>
      <xacro:control_joints items="${items[1:]}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:property name="control_items"
                  value="${[[gid + '_' + a,
                             min(max(0.0, ax[a]['min']), ax[a]['max']),
                             ax[a]['position_gain'] if ax[a].get('position_gain') is not None
                             else '']
                            for gid in python.sorted(spec['gantries'])
                            for ax in [spec['gantries'][gid]['axes']]
                            for a in ['x', 'y', 'z', 'c'] if ax.get(a) is not None]
                           + [[hid + s, 0.0, '']
                              for hid in python.sorted(spec['gang_heads'])
                              for s in (['_stroke_1', '_stroke_2']
                                        if (spec['gang_heads'][hid].get('opposed')
                                            and spec['gang_heads'][hid]['direction']
                                                == 'horizontal')
                                        else ['_stroke'])]}"/>

  <ros2_control name="LineSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:control_joints items="${control_items}"/>
  </ros2_control>

  <!-- Without this plugin (or with a bad parameters path) the controller manager never appears
       — the P1 finding, docs/decisions.md D-002. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
    <!-- Gazebo's own view of the joints, on /world/&lt;w&gt;/model/line/joint_state, which
         launch/line.launch.py bridges to /gz/joint_states. /joint_states is what
         joint_state_broadcaster reports from the hardware interface; this is what the physics
         engine says, so the two can be compared. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

</robot>
