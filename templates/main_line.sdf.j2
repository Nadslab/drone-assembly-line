{#- The main line world (plan P5.1). Rendered by tools/gen_world.py from line_spec.yaml. -#}
<?xml version="1.0"?>
<!-- {{ header }} -->
<sdf version="{{ sdf_version }}">
  <world name="{{ world_name }}">

    <physics name="{{ physics.name }}" type="{{ physics.type }}">
      <max_step_size>{{ physics.step_s }}</max_step_size>
      <real_time_factor>{{ physics.real_time_factor }}</real_time_factor>
    </physics>

    {#- Physics, SceneBroadcaster and UserCommands (set_pose, spawn) are what the checks and the
        sequencer drive the world with; Contact is what a contact sensor needs to exist at all. #}
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.85 0.87 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="Ground">
      <static>true</static>
      <link name="Ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

{%- for m in primitives %}

    <!-- {{ m.source }} -->
    <model name="{{ m.name }}">
      <static>true</static>
      <pose>{{ m.pose }}</pose>
      <link name="{{ m.name }}_link">
        <collision name="collision">
          <pose>{{ m.centre }} 0 0 0</pose>
          <geometry><box><size>{{ m.size }}</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>{{ m.centre }} 0 0 0</pose>
          <geometry><box><size>{{ m.size }}</size></box></geometry>
          <material>
            <ambient>{{ m.colour }}</ambient>
            <diffuse>{{ m.colour }}</diffuse>
          </material>
        </visual>
      </link>
    </model>
{%- endfor %}

{%- for inc in includes %}

    <!-- {{ inc.source }} -->
    <include>
      <uri>{{ inc.uri }}</uri>
      <name>{{ inc.name }}</name>
      <pose>{{ inc.pose }}</pose>
    </include>
{%- endfor %}

  </world>
</sdf>
