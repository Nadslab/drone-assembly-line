<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="frame_assembly_cell">

    <!-- Cell dimensions reference:
         Bench top:    1.0 x 0.6 m at z=0.900 (top surface)
         Bench legs:   4040 extrusion (0.04x0.04), 0.875 m tall
         Cell frame:   2020 extrusion (0.02x0.02), 0.6 m above bench
         Convention:   +Z up, +X is the long axis of the bench -->

    <!-- Physics: 1ms step, real-time factor 1.0 -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required system plugins for Gazebo Harmonic -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Models will be included below as we build them -->
    <!-- Workbench -->
    <include>
        <uri>model://workbench</uri>
        <pose>0 0 0 0 0 0</pose>
    </include>
    <!-- Cell frame (2020 extrusion cage) -->
    <include>
        <uri>model://cell_frame</uri>
         <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://frame_jig</uri>
      <name>frame_jig</name>
      <pose>0 0 0.9 0 0 0</pose>
    </include>

    <include>
      <uri>model://motor_jig</uri>
      <name>motor_jig</name>
      <pose>0.3 0 0.9 0 0 0</pose>
    </include>

    <!-- ── Dynamic parts (step 1.4) — fall under gravity ──────────────────
         Spawned at staggered z so you can watch gravity pull them down.
         None overlap the existing jigs (frame_jig at x=0 y=0,
         motor_jig at x=0.3 y=0).  All land on the workbench top (z≈0.9 m). -->

    <include>
      <uri>model://bottom_plate</uri>
      <name>bottom_plate</name>
      <!-- left-centre of bench, clear of frame_jig -->
      <pose>-0.35 0.00 1.2 0 0 0</pose>
    </include>

    <include>
      <uri>model://top_plate</uri>
      <name>top_plate</name>
      <!-- left of bench, offset in Y to clear frame_jig -->
      <pose>-0.10 0.20 1.4 0 0 0</pose>
    </include>

    <include>
      <uri>model://arm</uri>
      <name>arm</name>
      <!-- right of bench, clear of motor_jig in Y -->
      <pose>0.30 0.20 1.6 0 0 0</pose>
    </include>

    <include>
      <uri>model://m3_screw</uri>
      <name>m3_screw</name>
      <!-- front-left corner of bench -->
      <pose>-0.35 -0.20 1.8 0 0 0</pose>
    </include>

    <include>
      <uri>model://emax_motor</uri>
      <name>emax_motor</name>
      <!-- front-right corner of bench, clear of motor_jig in Y -->
      <pose>0.30 -0.20 2.0 0 0 0</pose>
    </include>

    <!-- ── Screw feeder (step 1.6) ───────────────────────────────────────
         Right side, near front edge of bench.
         Column base at world z=0.95 (5 mm above bench top at z=0.900).
         Inner channel: 30×40×150 mm.  Ramp exit ≈ (0.30, -0.231, 0.961).
         Pickup spawn point ≈ (0.30, -0.229, 0.967). -->
    <include>
      <uri>model://screw_feeder</uri>
      <name>screw_feeder</name>
      <pose>0.3 -0.2 0.95 0 0 0</pose>
    </include>

  </world>
</sdf>