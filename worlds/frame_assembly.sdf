<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="frame_assembly_cell">

    <!-- ── Layout reference ────────────────────────────────────────────────
         Assembly table: 3.0m (X) × 1.3m (Y), top at Z=0.900.
           X range: [-1.5, +1.5]   Y range: [-0.65, +0.65]
         Main conveyor:   Y=−0.15, runs X direction (parts flow +X → right)
         Return conveyor: Y=+0.35, parallel, parts flow −X ← left
         Side conveyor:   X=−1.40, Y=+0.10, connects return→main (left end)
         Finished area:   standalone platform at (X=−1.10, Y=+0.825)

         4 robot stations; front=−Y, back=+Y:
           St.1 X=−1.2  Screw Robot  — front (Y=−0.40) — bin_screw (−1.20,−0.55)
           St.1 X=−1.2  LeRobot #1   — back  (Y=+0.55) — A(−1.30,+0.65) B(−1.10,+0.65)
                                                            C(−1.30,+0.80) D(−1.10,+0.80)
           St.2 X=−0.6  LeRobot #2   — front (Y=−0.40) — E(−0.70,−0.55) F(−0.50,−0.55)
                                                            G(−0.70,−0.70) H(−0.50,−0.70)
           St.3 X= 0.0  Solder Robot — front (Y=−0.40) — no bins
           St.4 X=+0.6  LeRobot #3   — front (Y=−0.40) — I(+0.50,−0.55) J(+0.70,−0.55)
                                        back  (Y=+0.65) — K(+0.50,+0.65) L(+0.70,+0.65) [empty]

         Station markers: Y=+0.10 (front arms), Y=+0.40 (lerobot_1 back).
    ──────────────────────────────────────────────────────────────────────── -->

    <!-- Physics: 0.5ms step for numerical stability with 5 active arms -->
    <physics name="0.5ms" type="ignored">
      <max_step_size>0.0005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.38 0.38 0.38 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Assembly line table ──────────────────────────────────────────── -->
    <include>
      <uri>model://assembly_table</uri>
      <name>assembly_table</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ── Conveyors (all included at table surface Z=0.900) ────────────── -->
    <include>
      <uri>model://conveyor_main</uri>
      <name>conveyor_main</name>
      <pose>0 -0.15 0.900 0 0 0</pose>
    </include>

    <include>
      <uri>model://conveyor_return</uri>
      <name>conveyor_return</name>
      <pose>0 0.35 0.900 0 0 0</pose>
    </include>

    <include>
      <uri>model://conveyor_side</uri>
      <name>conveyor_side</name>
      <pose>-1.4 0.1 0.900 0 0 0</pose>
    </include>

    <!-- ── Finished product area ─────────────────────────────────────────── -->
    <include>
      <uri>model://finished_area</uri>
      <name>finished_area</name>
      <!-- Left of the table, centered on return-conveyor Y -->
      <pose>-1.1 0.825 0 0 0 0</pose>
    </include>

    <!-- ── Screw feeder (station 4, repositioned) ────────────────────────── -->
    <include>
      <uri>model://screw_feeder</uri>
      <name>screw_feeder</name>
      <!-- 50mm above table top (same offset as before) -->
      <pose>-1.0 0.1 0.950 0 0 0</pose>
    </include>

    <!-- ═══════════════════════════════════════════════════════════════════
         Robot station mounting markers — bright yellow discs on table.
         Cylinder radius 0.04m, height 0.020m, bottom at Z=0.900.
         Front arms: Y=+0.10 (between conveyors).
         lerobot_1 back: Y=+0.40 (just ahead of arm on back side).
    ═══════════════════════════════════════════════════════════════════════ -->

    <model name="station_marker_1">
      <static>true</static>
      <pose>-1.2 0.1 0.900 0 0 0</pose>
      <link name="disc">
        <pose>0 0 0.010 0 0 0</pose>
        <collision name="col">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
          <material><ambient>0.80 0.60 0.00 1</ambient><diffuse>1.00 0.75 0.00 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- lerobot_1 back side (Y=+0.40) -->
    <model name="station_marker_2">
      <static>true</static>
      <pose>-1.2 0.4 0.900 0 0 0</pose>
      <link name="disc">
        <pose>0 0 0.010 0 0 0</pose>
        <collision name="col">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
          <material><ambient>0.80 0.60 0.00 1</ambient><diffuse>1.00 0.75 0.00 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- lerobot_2 front (X=-0.6) -->
    <model name="station_marker_3">
      <static>true</static>
      <pose>-0.6 0.1 0.900 0 0 0</pose>
      <link name="disc">
        <pose>0 0 0.010 0 0 0</pose>
        <collision name="col">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
          <material><ambient>0.80 0.60 0.00 1</ambient><diffuse>1.00 0.75 0.00 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- solder_robot front (X=0.0) -->
    <model name="station_marker_4">
      <static>true</static>
      <pose>0.0 0.1 0.900 0 0 0</pose>
      <link name="disc">
        <pose>0 0 0.010 0 0 0</pose>
        <collision name="col">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
          <material><ambient>0.80 0.60 0.00 1</ambient><diffuse>1.00 0.75 0.00 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- lerobot_3 front (X=+0.6) -->
    <model name="station_marker_5">
      <static>true</static>
      <pose>0.6 0.1 0.900 0 0 0</pose>
      <link name="disc">
        <pose>0 0 0.010 0 0 0</pose>
        <collision name="col">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
          <material><ambient>0.80 0.60 0.00 1</ambient><diffuse>1.00 0.75 0.00 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         Parts bins — 13 total, each defined inline with a distinct color.
         Outer dims: 0.15 × 0.15 × 0.055m (5 links: floor + 4 walls).
         Z=0.900 for all bins (table surface height).

         Screw Robot:   bin_screw (−1.20,−0.55)
         LeRobot #1:    A(−1.30,+0.65) B(−1.10,+0.65)   [back side]
                        C(−1.30,+0.80) D(−1.10,+0.80)
         LeRobot #2:    E(−0.70,−0.55) F(−0.50,−0.55)   [front side]
                        G(−0.70,−0.70) H(−0.50,−0.70)
         Solder Robot:  (no bins)
         LeRobot #3:    I(+0.50,−0.55) J(+0.70,−0.55)   [front side]
                        K(+0.50,+0.65) L(+0.70,+0.65)   [back side, empty white]
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Bin A (red) — LeRobot #1, back side (−1.30, +0.65) ──────────── -->
    <model name="bin_A">
      <static>true</static>
      <pose>-1.30 0.65 0.900 0 0 0</pose>
      <link name="floor">
        <pose>0 0 0.005 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.15 0.15 0.010</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 0.15 0.010</size></box></geometry>
          <material><ambient>0.80 0.10 0.10 1</ambient><diffuse>1.00 0.20 0.20 1</diffuse></material></visual>
      </link>
      <link name="wall_front">
        <pose>0 -0.070 0.0325 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.15 0.010 0.045</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 0.010 0.045</size></box></geometry>
          <material><ambient>0.80 0.10 0.10 1</ambient><diffuse>1.00 0.20 0.20 1</diffuse></material></visual>
      </link>
      <link name="wall_back">
        <pose>0 0.070 0.0325 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.15 0.010 0.045</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 0.010 0.045</size></box></geometry>
          <material><ambient>0.80 0.10 0.10 1</ambient><diffuse>1.00 0.20 0.20 1</diffuse></material></visual>
      </link>
      <link name="wall_left">
        <pose>-0.070 0 0.0325 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.010 0.130 0.045</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.010 0.130 0.045</size></box></geometry>
          <material><ambient>0.80 0.10 0.10 1</ambient><diffuse>1.00 0.20 0.20 1</diffuse></material></visual>
      </link>
      <link name="wall_right">
        <pose>0.070 0 0.0325 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.010 0.130 0.045</size></box></geometry></collision>
