          <material><ambient>0.80 0.60 0.00 1</ambient><diffuse>1.00 0.75 0.00 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         Parts bins — 11 total, each defined inline with a distinct color.
         Outer dims: 0.15 × 0.15 × 0.10m (5 links: floor + 4 walls).
         All included at table surface Z=0.900 (bin floor bottom = table top).

         Station 1 (arm at X=−1.0): bins A B C D
         Station 2 (arm at X=−0.4): bins E F G H
         Station 3 (arm at X=+0.2): bins I J
         Station 4 screw feeder:    bin_screw
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Bin A (red) — station 1, left-outer ───────────────────────────── -->
    <model name="bin_A">
      <static>true</static>
      <pose>-1.20 -0.37 0.900 0 0 0</pose>
      <link name="floor">
        <pose>0 0 0.005 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.15 0.15 0.010</size></box></geometry></collision>
