          <material><ambient>0.80 0.60 0.00 1</ambient><diffuse>1.00 0.75 0.00 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="station_marker_5">
      <static>true</static>
      <pose>1.2 -0.35 0.900 0 0 0</pose>
      <link name="disc">
        <pose>0 0 0.010 0 0 0</pose>
        <collision name="col">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
          <material><ambient>0.80 0.60 0.00 1</ambient><diffuse>1.00 0.75 0.00 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         Parts bins — 11 total, each defined inline with a distinct color.
         Outer dims: 0.15 × 0.15 × 0.10m (5 links: floor + 4 walls).
         Z=0.900 for all bins (table surface height).

         St.1 X=−1.2  Screw Robot:  bin_screw (−1.2, −0.50)
         St.2 X=−0.6  LeRobot #1:   A(−0.7,−0.50) B(−0.5,−0.50)
                                     C(−0.7,−0.65) D(−0.5,−0.65)
         St.3 X= 0.0  LeRobot #2:   E(−0.1,−0.50) F(+0.1,−0.50)
                                     G(−0.1,−0.65) H(+0.1,−0.65)
         St.4 X=+0.6  Solder Robot: (no bins)
         St.5 X=+1.2  LeRobot #3:   I(+1.1,−0.50) J(+1.3,−0.50)
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Bin A (red) — station 1, left-outer ───────────────────────────── -->
    <model name="bin_A">
