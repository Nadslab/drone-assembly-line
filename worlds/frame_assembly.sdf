<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="frame_assembly_cell">

    <!-- ── Layout reference ────────────────────────────────────────────────
         Assembly table: 3.0m (X) × 0.9m (Y), top at Z=0.900.
           X range: [-1.5, +1.5]   Y range: [-0.45, +0.45]
         Main conveyor:   Y=0.000, runs X direction (parts flow +X → right)
         Return conveyor: Y=0.350, parallel, parts flow −X ← left
         Side conveyor:   X=−1.45, connects return→main (left end)
         Finished area:   standalone platform at (X=−1.8, Y=+0.8)

         5 robot stations at 0.6m spacing, ALL on front side (Y=−0.35):
           St.1 X=−1.2  Screw Robot  — bin_screw at (−1.2, −0.50)
           St.2 X=−0.6  LeRobot #1   — bins A/B front row Y=−0.50,
                                             C/D back row  Y=−0.65
           St.3 X= 0.0  LeRobot #2   — bins E/F front row Y=−0.50,
                                             G/H back row  Y=−0.65
           St.4 X=+0.6  Solder Robot — no bins
           St.5 X=+1.2  LeRobot #3   — bins I/J front row Y=−0.50

         Bins front row: Y=−0.50   bins back row: Y=−0.65
         Station markers: Y=−0.35, bright yellow discs on table surface.
    ──────────────────────────────────────────────────────────────────────── -->

    <!-- Physics: 1ms step, real-time factor 1.0 -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.38 0.38 0.38 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Assembly line table ──────────────────────────────────────────── -->
    <include>
      <uri>model://assembly_table</uri>
      <name>assembly_table</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ── Conveyors (all included at table surface Z=0.900) ────────────── -->
    <include>
      <uri>model://conveyor_main</uri>
      <name>conveyor_main</name>
      <pose>0 0 0.900 0 0 0</pose>
    </include>

    <include>
      <uri>model://conveyor_return</uri>
      <name>conveyor_return</name>
      <pose>0 0.35 0.900 0 0 0</pose>
    </include>

    <include>
      <uri>model://conveyor_side</uri>
      <name>conveyor_side</name>
      <pose>-1.45 0.175 0.900 0 0 0</pose>
    </include>

    <!-- ── Finished product area ─────────────────────────────────────────── -->
    <include>
      <uri>model://finished_area</uri>
      <name>finished_area</name>
      <!-- Left of the table, centered on return-conveyor Y -->
      <pose>-1.8 0.8 0 0 0 0</pose>
    </include>

    <!-- ── Screw feeder (station 4, repositioned) ────────────────────────── -->
    <include>
      <uri>model://screw_feeder</uri>
      <name>screw_feeder</name>
      <!-- 50mm above table top (same offset as before) -->
      <pose>-1.2 -0.35 0.950 0 0 0</pose>
    </include>

    <!-- ═══════════════════════════════════════════════════════════════════
         Robot station mounting markers — bright yellow discs on table.
         Cylinder radius 0.04m, height 0.020m, bottom at Z=0.900.
         Y=−0.42: front edge of table, between conveyor rail and table edge.
    ═══════════════════════════════════════════════════════════════════════ -->

    <model name="station_marker_1">
      <static>true</static>
      <pose>-1.2 -0.35 0.900 0 0 0</pose>
      <link name="disc">
        <pose>0 0 0.010 0 0 0</pose>
        <collision name="col">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
          <material><ambient>0.80 0.60 0.00 1</ambient><diffuse>1.00 0.75 0.00 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="station_marker_2">
      <static>true</static>
      <pose>-0.6 -0.35 0.900 0 0 0</pose>
      <link name="disc">
        <pose>0 0 0.010 0 0 0</pose>
        <collision name="col">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
          <material><ambient>0.80 0.60 0.00 1</ambient><diffuse>1.00 0.75 0.00 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="station_marker_3">
      <static>true</static>
      <pose>0.0 -0.35 0.900 0 0 0</pose>
      <link name="disc">
        <pose>0 0 0.010 0 0 0</pose>
        <collision name="col">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.04</radius><length>0.020</length></cylinder></geometry>
          <material><ambient>0.80 0.60 0.00 1</ambient><diffuse>1.00 0.75 0.00 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="station_marker_4">
      <static>true</static>
      <pose>0.6 -0.35 0.900 0 0 0</pose>
