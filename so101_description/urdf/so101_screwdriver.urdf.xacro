<?xml version="1.0" encoding="utf-8"?>
<!--
  Screwdriver variant of the SO-101 arm.

  Includes so101.urdf.xacro with screwdriver:=true, which adds:
    - screwdriver_tip_link  (bit_holder mesh + screwdriver_bit mesh)
    - screwdriver_tip_joint (fixed, parent gripper_link)

  Usage (xacro.process_file):
    mappings={'namespace': 'screw_robot'}          # screwdriver defaults to true
    mappings={'namespace': 'screw_robot',
              'screwdriver': 'false'}               # override to suppress tip

  Pass namespace and controllers_yaml as usual — they flow through to
  so101.urdf.xacro unchanged.
-->
<robot name="so101" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Declare args before the include so the screwdriver default is true.
       xacro uses first-declaration-wins; the inner file's default="false"
       for screwdriver is therefore a no-op. -->
  <xacro:arg name="namespace"        default=""/>
  <xacro:arg name="controllers_yaml"
             default="$(find so101_description)/config/ros2_controllers.yaml"/>
  <xacro:arg name="screwdriver"      default="true"/>

  <xacro:include filename="$(find so101_description)/urdf/so101.urdf.xacro"/>

</robot>
