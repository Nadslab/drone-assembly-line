<?xml version="1.0" encoding="utf-8"?>
<!--
  Screwdriver variant of the SO-101 arm.

  Includes so101.urdf.xacro unchanged, then conditionally appends a
  2.5 mm hex screwdriver tip modelled from primitives:
    - shaft   : cylinder r=4 mm, l=50 mm
    - taper   : cylinder r=2 mm, l=5 mm
    - hex bit : box 2.5×2.5×12 mm

  The tip is attached as a fixed child of gripper_link pointing −Z.

  Usage (xacro.process_file):
    mappings={'namespace': 'screw_robot', 'screwdriver': 'true'}   # with tip
    mappings={'namespace': 'some_arm'}                              # no tip (default false)
-->
<robot name="so101" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Declare args before include so they are available to the inner file.
       xacro uses first-declaration-wins; the inner file's own declarations
       for namespace and controllers_yaml are therefore no-ops. -->
  <xacro:arg name="namespace"        default=""/>
  <xacro:arg name="controllers_yaml"
             default="$(find so101_description)/config/ros2_controllers.yaml"/>
  <xacro:arg name="screwdriver"      default="false"/>

  <xacro:include filename="$(find so101_description)/urdf/so101.urdf.xacro"/>

  <!-- ── Screwdriver tip (only when screwdriver:=true) ─────────────────── -->
  <xacro:if value="$(arg screwdriver)">

    <link name="screwdriver_tip_link">
      <inertial>
        <!-- Centre of mass at mid-shaft -->
        <origin xyz="0 0 -0.025" rpy="0 0 0"/>
        <mass value="0.05"/>
        <!-- Thin solid cylinder approx: ixx = iyy = m(3r²+l²)/12, izz = mr²/2
             r=0.004 m  l=0.050 m  m=0.05 kg
             ixx = 0.05*(3*0.000016+0.0025)/12 = 1.058e-5
             izz = 0.05*0.000016/2             = 4.0e-7                      -->
        <inertia ixx="1.06e-05" ixy="0" ixz="0"
                 iyy="1.06e-05" iyz="0"
                 izz="4.0e-07"/>
      </inertial>

      <!-- Shaft: cylinder r=4 mm, l=50 mm, centred at (0,0,-0.025) -->
      <visual>
        <origin xyz="0 0 -0.025" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.004" length="0.050"/>
        </geometry>
        <material name="screwdriver_silver">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </visual>

      <!-- Taper: cylinder r=2 mm, l=5 mm, just below shaft tip -->
      <visual>
        <origin xyz="0 0 -0.0525" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.002" length="0.005"/>
        </geometry>
        <material name="screwdriver_silver">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </visual>

      <!-- Hex bit: box 2.5×2.5×12 mm, below taper -->
      <visual>
        <origin xyz="0 0 -0.061" rpy="0 0 0"/>
        <geometry>
          <box size="0.0025 0.0025 0.012"/>
        </geometry>
        <material name="screwdriver_silver">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </visual>

      <!-- Collision: single cylinder encompassing shaft + taper + bit -->
      <collision>
        <origin xyz="0 0 -0.0335" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.004" length="0.067"/>
        </geometry>
      </collision>
    </link>

    <joint name="screwdriver_tip_joint" type="fixed">
      <!-- Offset 30 mm down from gripper_link origin along −Z -->
      <origin xyz="0 0 -0.030" rpy="0 0 0"/>
      <parent link="gripper_link"/>
      <child  link="screwdriver_tip_link"/>
    </joint>

  </xacro:if>

</robot>
