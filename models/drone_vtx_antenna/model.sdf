<?xml version="1.0"?>
<sdf version="1.9">
  <model name="drone_vtx_antenna">
    <!--
      VTX antenna — plastic, rho = 500 kg/m³.
      STL bbox (m): X[0,0.0290]  Y[0,0.0507]  Z[0.0050,0.0468]  (Y is tall axis)
      Collision box (m): 0.029000 × 0.050700 × 0.041800
        V = 0.029 * 0.0507 * 0.0418 = 6.146e-5 m³
        m = 6.146e-5 * 500 = 0.03073 kg
      Box inertia:
        Ixx = m*(ly²+lz²)/12 = 0.03073*(0.0507²+0.0418²)/12 = 1.10e-5 kg·m²
        Iyy = m*(lx²+lz²)/12 = 0.03073*(0.029²+0.0418²)/12 = 6.62e-6 kg·m²
        Izz = m*(lx²+ly²)/12 = 0.03073*(0.029²+0.0507²)/12 = 8.73e-6 kg·m²
    -->
    <link name="link">
      <inertial>
        <mass>0.03073</mass>
        <inertia>
          <ixx>1.10e-5</ixx>  <ixy>0</ixy>  <ixz>0</ixz>
          <iyy>6.62e-6</iyy>  <iyz>0</iyz>
          <izz>8.73e-6</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box><size>0.029000 0.050700 0.041800</size></box>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>-0.014500 -0.025350 -0.025900 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://drone_vtx_antenna/meshes/vtx_antenna.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.20 0.20 0.20 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
