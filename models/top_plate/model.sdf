<?xml version="1.0"?>
<sdf version="1.9">
  <model name="top_plate">
    <!--
      GEPRC Mark 4 7" top plate — carbon fibre, rho = 1600 kg/m³.

      Reference envelope (collision bbox): 263 x 223 x 2 mm
        Identical to bottom_plate → same mass and inertia.
        m = 0.1878 kg
        Ixx = 7.779e-4 kg·m²
        Iyy = 1.0820e-3 kg·m²
        Izz = 1.8590e-3 kg·m²  (Ixx+Iyy=1.8599e-3 > Izz ✓)

      Visual: top_plate.stl (already in metres, 40x172x2.5mm bounding box).
        STL bbox: X [0, 0.0404], Y [0, 0.1723], Z [0, 0.0025]
        Offset = (-0.0202, -0.08615, -0.00125)
    -->

    <link name="link">
      <inertial>
        <mass>0.1877</mass>
        <inertia>
          <ixx>7.779e-4</ixx>  <ixy>0</ixy>  <ixz>0</ixz>
          <iyy>1.0820e-3</iyy> <iyz>0</iyz>
          <izz>1.8590e-3</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box><size>0.263 0.223 0.002</size></box>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>-0.0202 -0.08615 -0.00125 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://top_plate/top_plate.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>

  </model>
</sdf>
