<?xml version="1.0"?>
<model>
  <name>bottom_plate</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    GEPRC Mark 4 7" bottom plate — carbon fiber, 2mm thick.
    Visual: real STL (bottom_plate.stl, already in metres).
    Collision: box primitive from Mark 4 reference envelope 263x223x2mm.
    Mass/inertia calculated analytically from collision bbox, rho=1600 kg/m3.
  </description>
</model>
