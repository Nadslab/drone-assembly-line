<?xml version="1.0"?>
<sdf version="1.9">
  <model name="drone_bottom_plate">
    <!--
      Mark 4 bottom plate — carbon fibre, rho = 1600 kg/m³.
      STL bbox (m): X[0,0.0496]  Y[0,0.1766]  Z[0,0.0025]
      Collision box (m): 0.0496 × 0.1766 × 0.0025
        V = 0.0496 * 0.1766 * 0.0025 = 2.190e-5 m³
        m = 2.190e-5 * 1600 = 0.03504 kg
      Box inertia:
        Ixx = m*(ly²+lz²)/12 = 0.03504*(0.1766²+0.0025²)/12 = 9.11e-5 kg·m²
        Iyy = m*(lx²+lz²)/12 = 0.03504*(0.0496²+0.0025²)/12 = 7.20e-6 kg·m²
        Izz = m*(lx²+ly²)/12 = 0.03504*(0.0496²+0.1766²)/12 = 9.82e-5 kg·m²
    -->
    <link name="link">
      <inertial>
        <mass>0.03504</mass>
        <inertia>
          <ixx>9.11e-5</ixx>  <ixy>0</ixy>  <ixz>0</ixz>
          <iyy>7.20e-6</iyy>  <iyz>0</iyz>
          <izz>9.82e-5</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box><size>0.0496 0.1766 0.0025</size></box>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>-0.024800 -0.088300 -0.001250 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://drone_bottom_plate/meshes/bottom_plate.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
