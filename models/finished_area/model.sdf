<?xml version="1.0" ?>
<sdf version="1.10">
  <!-- Finished product area: standalone 0.7m x 0.7m platform at table height.
       Green tinted to indicate output zone.
       Include in world at (-2.0, 0.175, 0) — to the left of the main table.
       Top surface at z=0.900 (matching table). -->
  <model name="finished_area">
    <static>true</static>

    <!-- Platform top slab: 0.7 x 0.7 x 0.025m, top at z=0.900 -->
    <link name="top">
      <pose>0 0 0.8875 0 0 0</pose>
      <collision name="col">
        <geometry><box><size>0.7 0.7 0.025</size></box></geometry>
      </collision>
      <visual name="vis">
        <geometry><box><size>0.7 0.7 0.025</size></box></geometry>
        <material>
          <ambient>0.10 0.40 0.10 1</ambient>
          <diffuse>0.15 0.60 0.15 1</diffuse>
          <specular>0.05 0.10 0.05 1</specular>
        </material>
      </visual>
    </link>

    <!-- 4 corner legs: 0.04x0.04x0.875m, center at z=0.4375 -->
    <link name="leg_fl">
      <pose>-0.32 -0.32 0.4375 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.04 0.04 0.875</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.04 0.04 0.875</size></box></geometry>
        <material><ambient>0.15 0.30 0.15 1</ambient><diffuse>0.20 0.45 0.20 1</diffuse></material>
      </visual>
    </link>
    <link name="leg_fr">
      <pose>-0.32  0.32 0.4375 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.04 0.04 0.875</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.04 0.04 0.875</size></box></geometry>
        <material><ambient>0.15 0.30 0.15 1</ambient><diffuse>0.20 0.45 0.20 1</diffuse></material>
      </visual>
    </link>
    <link name="leg_bl">
      <pose> 0.32 -0.32 0.4375 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.04 0.04 0.875</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.04 0.04 0.875</size></box></geometry>
        <material><ambient>0.15 0.30 0.15 1</ambient><diffuse>0.20 0.45 0.20 1</diffuse></material>
      </visual>
    </link>
    <link name="leg_br">
      <pose> 0.32  0.32 0.4375 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.04 0.04 0.875</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.04 0.04 0.875</size></box></geometry>
        <material><ambient>0.15 0.30 0.15 1</ambient><diffuse>0.20 0.45 0.20 1</diffuse></material>
      </visual>
    </link>

    <!-- Label ring on top surface to highlight finished-area -->
    <link name="border">
      <pose>0 0 0.902 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.7 0.7 0.004</size></box></geometry>
        <material>
          <ambient>0.05 0.55 0.05 1</ambient>
          <diffuse>0.10 0.80 0.10 1</diffuse>
        </material>
      </visual>
    </link>

  </model>
</sdf>
