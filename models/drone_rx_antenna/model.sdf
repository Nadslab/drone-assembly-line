<?xml version="1.0"?>
<sdf version="1.9">
  <model name="drone_rx_antenna">
    <!--
      RX antenna — plastic, rho = 500 kg/m³.
      STL bbox (m): X[0,0.0350]  Y[0,0.0545]  Z[0,0.0095]  (Y is tall axis)
      Collision box (m): 0.035000 × 0.054500 × 0.009500
        V = 0.035 * 0.0545 * 0.0095 = 1.812e-5 m³
        m = 1.812e-5 * 500 = 0.009062 kg
      Box inertia:
        Ixx = m*(ly²+lz²)/12 = 0.009062*(0.0545²+0.0095²)/12 = 2.31e-6 kg·m²
        Iyy = m*(lx²+lz²)/12 = 0.009062*(0.035²+0.0095²)/12 = 9.93e-7 kg·m²
        Izz = m*(lx²+ly²)/12 = 0.009062*(0.035²+0.0545²)/12 = 3.17e-6 kg·m²
    -->
    <link name="link">
      <inertial>
        <mass>0.009062</mass>
        <inertia>
          <ixx>2.31e-6</ixx>  <ixy>0</ixy>  <ixz>0</ixz>
          <iyy>9.93e-7</iyy>  <iyz>0</iyz>
          <izz>3.17e-6</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box><size>0.035000 0.054500 0.009500</size></box>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>-0.017500 -0.027250 -0.004750 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://drone_rx_antenna/meshes/rx_antenna.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
