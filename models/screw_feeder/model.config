<?xml version="1.0"?>
<model>
  <name>screw_feeder</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Gravity-fed M3 screw magazine feeder.
    Vertical column: 30 mm wide × 40 mm deep × 150 mm tall (inner channel).
    Wall thickness 2 mm each side. Open top (loading), open bottom (pickup).
    Angled pickup ramp at bottom guides screws to defined exit point.
  </description>
</model>
