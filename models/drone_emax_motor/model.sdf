<?xml version="1.0"?>
<sdf version="1.9">
  <model name="drone_emax_motor">
    <!--
      EMAX motor — metal, rho = 7800 kg/m³.
      STL bbox (m): X[0,0.0279]  Y[0.0376,0.0738]  Z[0.0083,0.0362]
      Collision box (m): 0.0279 × 0.0362 × 0.0279
        V = 0.0279 * 0.0362 * 0.0279 = 2.819e-5 m³
        m = 2.819e-5 * 7800 = 0.2199 kg
      Box inertia (lx=lz=0.0279, ly=0.0362):
        Ixx = m*(ly²+lz²)/12 = 0.2199*(0.0362²+0.0279²)/12 = 3.82e-5 kg·m²
        Iyy = m*(lx²+lz²)/12 = 0.2199*(0.0279²+0.0279²)/12 = 2.86e-5 kg·m²
        Izz = m*(lx²+ly²)/12 = 0.2199*(0.0279²+0.0362²)/12 = 3.82e-5 kg·m²
    -->
    <link name="link">
      <inertial>
        <mass>0.2199</mass>
        <inertia>
          <ixx>3.82e-5</ixx>  <ixy>0</ixy>  <ixz>0</ixz>
          <iyy>2.86e-5</iyy>  <iyz>0</iyz>
          <izz>3.82e-5</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box><size>0.0279 0.0362 0.0279</size></box>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>-0.013950 -0.055700 -0.022250 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://drone_emax_motor/meshes/emax_motor.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.06 0.06 0.10 1</ambient>
          <diffuse>0.10 0.10 0.20 1</diffuse>
          <specular>0.4 0.4 0.5 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
