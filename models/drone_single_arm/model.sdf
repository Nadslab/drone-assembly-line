<?xml version="1.0"?>
<sdf version="1.9">
  <model name="drone_single_arm">
    <!--
      Mk4 7in single arm — carbon fibre, rho = 1600 kg/m³.
      STL bbox (mm): X[4.890,138.993]  Y[0,90.049]  Z[0.003,5.003]
      Collision box (m): 0.134103 × 0.090049 × 0.005000
        V = 0.134103 * 0.090049 * 0.005 = 6.035e-5 m³
        m = 6.035e-5 * 1600 = 0.09656 kg
      Box inertia:
        Ixx = m*(ly²+lz²)/12 = 0.09656*(0.090049²+0.005²)/12 = 6.54e-5 kg·m²
        Iyy = m*(lx²+lz²)/12 = 0.09656*(0.134103²+0.005²)/12 = 1.45e-4 kg·m²
        Izz = m*(lx²+ly²)/12 = 0.09656*(0.134103²+0.090049²)/12 = 2.10e-4 kg·m²
    -->
    <link name="link">
      <inertial>
        <mass>0.09656</mass>
        <inertia>
          <ixx>6.54e-5</ixx>  <ixy>0</ixy>  <ixz>0</ixz>
          <iyy>1.45e-4</iyy>  <iyz>0</iyz>
          <izz>2.10e-4</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box><size>0.134103 0.090049 0.005000</size></box>
        </geometry>
      </collision>

      <visual name="visual">
        <!-- STL centre offset to align mesh with link origin -->
        <pose>-0.071942 -0.045024 -0.002503 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://drone_single_arm/meshes/single_arm.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
