<?xml version="1.0" ?>
<sdf version="1.10">
  <!-- Assembly line table: 3.0m x 1.3m x 0.900m tall.
       Slab top surface sits at z=0.900 in model frame.
       Include in world at (0,0,0). -->
  <model name="assembly_table">
    <static>true</static>

    <!-- Table top slab: 3.0 x 1.3 x 0.025m, top at z=0.900 -->
    <link name="top">
      <pose>0 0 0.8875 0 0 0</pose>
      <collision name="col">
        <geometry><box><size>3.0 1.3 0.025</size></box></geometry>
      </collision>
      <visual name="vis">
        <geometry><box><size>3.0 1.3 0.025</size></box></geometry>
        <material>
          <ambient>0.30 0.20 0.10 1</ambient>
          <diffuse>0.50 0.35 0.18 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>

    <!-- 6 legs in a 3x2 grid: x ∈ {-1.46, 0, +1.46}, y ∈ {-0.61, +0.61}
         Each leg: 0.04x0.04x0.875m, center at z=0.4375 -->
    <link name="leg_fl">
      <pose>-1.46 -0.61 0.4375 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.04 0.04 0.875</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.04 0.04 0.875</size></box></geometry>
        <material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
      </visual>
    </link>
    <link name="leg_fr">
      <pose>-1.46  0.61 0.4375 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.04 0.04 0.875</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.04 0.04 0.875</size></box></geometry>
        <material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
      </visual>
    </link>
    <link name="leg_ml">
      <pose>0.00 -0.61 0.4375 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.04 0.04 0.875</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.04 0.04 0.875</size></box></geometry>
        <material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
      </visual>
    </link>
    <link name="leg_mr">
      <pose>0.00  0.61 0.4375 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.04 0.04 0.875</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.04 0.04 0.875</size></box></geometry>
        <material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
      </visual>
    </link>
    <link name="leg_bl">
      <pose>1.46 -0.61 0.4375 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.04 0.04 0.875</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.04 0.04 0.875</size></box></geometry>
        <material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
      </visual>
    </link>
    <link name="leg_br">
      <pose>1.46  0.61 0.4375 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.04 0.04 0.875</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.04 0.04 0.875</size></box></geometry>
        <material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
      </visual>
    </link>

  </model>
</sdf>
